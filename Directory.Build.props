<Project>

    <!-- Shared NuGet metadata for TelegramBotForge and TelegramBotForge.AspNetCore. -->
    <PropertyGroup>
        <VersionPrefix>0.2.0</VersionPrefix>
        <Authors>VAXA99</Authors>
        <Copyright>Copyright (c) 2026 VAXA99</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/VAXA99/TelegramBotForge</PackageProjectUrl>
        <RepositoryUrl>https://github.com/VAXA99/TelegramBotForge</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>telegram;telegram-bot;bot;mvc;controllers;attributes;telegram-stars</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- XML docs go into the package, so the IDE shows them to users of the library. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- SourceLink: lets users step into TelegramBotForge sources while debugging. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!-- Every change to the public API shows up in PublicAPI.Unshipped.txt, so it is reviewed on purpose (RS0016, RS0017).
         On release, the lines of PublicAPI.Unshipped.txt move to PublicAPI.Shipped.txt. -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all"/>
        <AdditionalFiles Include="PublicAPI.Shipped.txt"/>
        <AdditionalFiles Include="PublicAPI.Unshipped.txt"/>
    </ItemGroup>

    <!-- RS0026/RS0027 (overloads with optional parameters) would flag DownloadFile, which ITelegramBotClient dictates, and
         RS0022 flags View/View<T>, which are meant to be derived from although ViewBase is not. -->
    <PropertyGroup Condition="'$(IsPackable)' != 'false'">
        <NoWarn>$(NoWarn);RS0022;RS0026;RS0027</NoWarn>
    </PropertyGroup>

    <!-- SourceLink is built into the .NET 8+ SDK (a package reference would only pin an older, vulnerable copy).
         Packages are published from GitHub Actions only, so it is on there; locally it would fail -warnaserror builds
         of a copy without a git remote. -->
    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != 'true'">
        <EnableSourceLink>false</EnableSourceLink>
    </PropertyGroup>

</Project>
