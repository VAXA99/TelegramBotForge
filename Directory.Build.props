<Project>

    <!-- Shared NuGet metadata for TelegramBotForge and TelegramBotForge.AspNetCore. -->
    <PropertyGroup>
        <VersionPrefix>0.1.0</VersionPrefix>
        <Authors>VAXA99</Authors>
        <Copyright>Copyright (c) 2026 VAXA99</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/VAXA99/TelegramBotForge</PackageProjectUrl>
        <RepositoryUrl>https://github.com/VAXA99/TelegramBotForge</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>telegram;telegram-bot;bot;mvc;controllers;attributes;telegram-stars</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- XML docs go into the package, so the IDE shows them to users of the library. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- SourceLink: lets users step into TelegramBotForge sources while debugging. -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Deterministic>true</Deterministic>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <!-- Packages are published from GitHub Actions only, so SourceLink is only needed there
         (locally it would fail -warnaserror builds while the repository has no remote). -->
    <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(GITHUB_ACTIONS)' == 'true'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
    </ItemGroup>

</Project>
