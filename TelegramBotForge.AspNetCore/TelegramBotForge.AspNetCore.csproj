<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>TelegramBotForge.AspNetCore</PackageId>
        <Description>Webhook mode and a health check for TelegramBotForge bots on ASP.NET Core: maps the endpoint that receives updates from Telegram.</Description>
        <PackageTags>$(PackageTags);aspnetcore;webhook</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="TelegramBotForge.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TelegramBotForge\TelegramBotForge.csproj"/>
    </ItemGroup>

</Project>
