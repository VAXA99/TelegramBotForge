<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackageId>TelegramBotForge.Testing</PackageId>
        <Description>Test TelegramBotForge bots without Telegram: send messages, press buttons and pay invoices as a user, and check what the bot answered. Works with any test framework.</Description>
        <PackageTags>$(PackageTags);testing</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TelegramBotForge\TelegramBotForge.csproj"/>
    </ItemGroup>

</Project>
