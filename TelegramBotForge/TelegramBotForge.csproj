<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>TelegramBotForge</RootNamespace>
        <PackageId>TelegramBotForge</PackageId>
        <Description>Build Telegram bots quickly with MVC: controllers with attribute routes for commands, buttons, text, media, inline queries and Telegram Stars payments, plus declarative views, conversation state, middleware, filters, flood control and broadcasts.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!-- Abstractions only: the application chooses its own host and versions. -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1"/>
        <PackageReference Include="Telegram.Bot" Version="22.10.3.1"/>
        <PackageReference Include="System.Threading.RateLimiting" Version="8.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <!-- UseWebhook() in TelegramBotForge.AspNetCore switches the internal update mode. -->
        <InternalsVisibleTo Include="TelegramBotForge.AspNetCore"/>
        <InternalsVisibleTo Include="TelegramBotForge.Testing"/>
        <InternalsVisibleTo Include="TelegramBotForge.Tests"/>
    </ItemGroup>

</Project>
